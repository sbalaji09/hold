{
  "name": "hold",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:all": "concurrently --names convex,web,voice --prefix-colors blue,green,magenta --kill-others-on-fail \"convex dev\" \"next dev\" \"pnpm voice:dev\"",
    "convex:dev": "convex dev",
    "seed": "convex run seed:seed \"$(cat data/fogline.json)\"",
    "seed:bayline": "convex run seed:seed \"$(cat data/bayline.json)\"",
    "seed:harbor": "convex run seed:seed \"$(cat data/harbor.json)\"",
    "voice:dev": "tsx watch --include .env --env-file=.env voice/src/main.ts",
    "voice:start": "tsx --env-file-if-exists=.env voice/src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "next build",
    "start": "next start"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "concurrently": "^10.0.6",
    "convex-test": "^0.0.65",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@inferedge/moss": "^1.0.0-beta.8",
    "@ngrok/ngrok": "^1.7.0",
    "convex": "^1.48.0",
    "lucide-react": "^0.468.0",
    "next": "^15.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "twilio": "^6.2.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "version": "0.1.0"
}
