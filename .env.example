# Copy to .env and fill in. Never commit .env.

# Twilio: one upgraded (non-trial) number for Fogline's line
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# Cartesia: STT (ink-whisper) + TTS (Sonic)
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=

# Claude
ANTHROPIC_API_KEY=

# Moss (also set in Convex: npx convex env set MOSS_PROJECT_ID ...)
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=

# Convex (npx convex dev writes CONVEX_DEPLOYMENT / CONVEX_URL to .env.local)
CONVEX_URL=
# Shared secret between the voice server and Convex.
# Also run: npx convex env set VOICE_SERVER_SECRET <same value>
VOICE_SERVER_SECRET=

# Public https URL Twilio uses to reach the voice server (ngrok in dev)
PUBLIC_BASE_URL=https://xxxx.ngrok-free.app
PORT=8080

# Optional: "End call and take over" transfers the live call here
MAYA_PHONE_NUMBER=

# Convex-side only (set with: npx convex env set NAME value)
#   VOICE_SERVER_SECRET, ANTHROPIC_API_KEY, MOSS_PROJECT_ID, MOSS_PROJECT_KEY, TWILIO_PHONE_NUMBER
#   CALL_RETRY_DELAY_MS   delay before the one no-answer retry (default 120000)
#   DEMO_SUPPLIER_PHONE   dev seed: phone_on_file for Northgate Staging (the teammate's phone)
