# Copy to .env and fill in. Never commit .env.

# Twilio: one upgraded (non-trial) number for Fogline's line
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# Cartesia: STT (ink-whisper) + TTS (Sonic)
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=

# Claude
ANTHROPIC_API_KEY=

# Moss (also set in Convex: npx convex env set MOSS_PROJECT_ID ...)
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=

# Convex (npx convex dev writes CONVEX_DEPLOYMENT / CONVEX_URL to .env.local)
CONVEX_URL=
# Same value as CONVEX_URL, but exposed to the browser bundle (client-side Convex client).
NEXT_PUBLIC_CONVEX_URL=
# Shared secret between the voice server and Convex.
# Also run: npx convex env set VOICE_SERVER_SECRET <same value>
VOICE_SERVER_SECRET=

# Local dev: your free permanent ngrok domain (ngrok dashboard -> Domains) and authtoken.
# The voice server opens the tunnel itself; PUBLIC_BASE_URL then defaults to https://<NGROK_DOMAIN>.
NGROK_DOMAIN=
NGROK_AUTHTOKEN=
# Point Fogline's Twilio number at this server on startup (whichever server starts last owns it).
TWILIO_POINT_WEBHOOK=true
# Only when not using NGROK_DOMAIN.
PUBLIC_BASE_URL=
PORT=8080

# Inbound email intake: shared secret the Convex HTTP action checks against x-hold-secret.
# Convex-side only: npx convex env set INBOUND_EMAIL_SECRET <same value>
INBOUND_EMAIL_SECRET=

# Inbound email intake: the address suppliers/judges send bills to (shown on /card).
INBOUND_EMAIL_ADDRESS=

# Increase (sandbox bank transfers). Convex-side only:
# npx convex env set INCREASE_API_KEY value; npx convex env set INCREASE_ACCOUNT_ID value
INCREASE_API_KEY=
INCREASE_ACCOUNT_ID=

# Optional: "End call and take over" transfers the live call here
MAYA_PHONE_NUMBER=

# Convex-side only (set with: npx convex env set NAME value)
#   VOICE_SERVER_SECRET, ANTHROPIC_API_KEY, MOSS_PROJECT_ID, MOSS_PROJECT_KEY, TWILIO_PHONE_NUMBER
#   INBOUND_EMAIL_SECRET, INCREASE_API_KEY, INCREASE_ACCOUNT_ID, APIFY_TOKEN, APIFY_ACTOR_ID
#   CALL_RETRY_DELAY_MS   delay before the one no-answer retry (default 120000)

# Apify (background + copycat check). Convex-side only:
# npx convex env set APIFY_TOKEN value; npx convex env set APIFY_ACTOR_ID value
APIFY_TOKEN=
APIFY_ACTOR_ID=
